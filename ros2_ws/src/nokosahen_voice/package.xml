<?xml version="1.0"?>
<package format="3">
  <name>nokosahen_voice</name>
  <version>0.1.0</version>
  <description>Bridges /nokosahen/announce_text to the host-side voice_bridge (VOICEVOX + Ollama) service.</description>
  <maintainer email="mirs@example.local">MIRS</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <exec_depend>python3-requests</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
