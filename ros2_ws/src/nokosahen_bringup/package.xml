<?xml version="1.0"?>
<package format="3">
  <name>nokosahen_bringup</name>
  <version>0.1.0</version>
  <description>Launch, Nav2, SLAM, and behavior tree configuration for Nokosahen.</description>
  <maintainer email="mirs@example.local">MIRS</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>nokosahen_core</exec_depend>
  <exec_depend>nokosahen_voice</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>rplidar_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>micro_ros_agent</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
