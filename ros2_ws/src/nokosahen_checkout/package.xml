<?xml version="1.0"?>
<package format="3">
  <name>nokosahen_checkout</name>
  <version>0.1.0</version>
  <description>
    メニュー毎の決済場所に置く独立ユニット(Webカメラ+Raspberry Pi 4)用のROS 2ノード。
    どのRaspberry Piにも同一コードをそのまま導入し、実行時にCPUシリアルから自機を
    自己識別する。メニュー割り当てはJetson側の完成版ダッシュボードから行う。
  </description>
  <maintainer email="mirs@example.local">MIRS</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
