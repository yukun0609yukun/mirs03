<?xml version="1.0"?>
<package format="3">
  <name>nokosahen_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo classic simulation (robot model, cafeteria world, sim launch) for Nokosahen.</description>
  <maintainer email="mirs@example.local">MIRS</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros_pkgs</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>nokosahen_core</exec_depend>
  <exec_depend>nokosahen_voice</exec_depend>
  <exec_depend>nokosahen_checkout</exec_depend>
  <exec_depend>nokosahen_bringup</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
